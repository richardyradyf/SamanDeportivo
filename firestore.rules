rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function esPropietario(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    function usuarioActual() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function esAdministrador() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && usuarioActual().rol == 'administrador';
    }

    // NO usar esta condición como prueba de solvencia UNIMET.
    // El estado fue definido en el Hito 1, pero la validación institucional
    // se integrará en Hito 3 mediante lógica privilegiada del servidor.
    // Los indices del estudiante deben existir en el mismo commit.
    function indicesEstudianteValidos(uid, cedula, carnet) {
      return getAfter(
          /databases/$(database)/documents/cedulas/$(cedula)
        ).data.uid == uid
        && getAfter(
          /databases/$(database)/documents/carnets/$(carnet)
        ).data.uid == uid;
    }

    function nuevoEstudianteValido(uid) {
      let d = request.resource.data;

      return esPropietario(uid)
        && d.keys().hasAll([
          'cedula', 'nombre', 'correo', 'rol', 'carnet', 'estado'
        ])
        && d.keys().hasOnly([
          'cedula', 'nombre', 'correo', 'rol', 'carnet', 'estado'
        ])
        && d.rol == 'estudiante'
        && d.estado == 'activo'
        && d.nombre is string
        && d.nombre.size() >= 2
        && d.nombre.size() <= 100
        && d.correo is string
        && d.correo == request.auth.token.email
        && d.cedula is string
        && d.cedula.matches('^[0-9]{5,20}$')
        && d.carnet is string
        && d.carnet.matches('^[a-zA-Z0-9-]{4,24}$')
        && indicesEstudianteValidos(uid, d.cedula, d.carnet);
    }

    // Mantener la creacion de entrenadores de Alexander.
    function nuevoEntrenadorAdminValido(uid) {
      let d = request.resource.data;

      return esAdministrador()
        && d.keys().hasAll([
          'nombre', 'correo', 'cedula', 'rol',
          'especialidad', 'aniosExperiencia'
        ])
        && d.keys().hasOnly([
          'nombre', 'correo', 'cedula', 'rol',
          'especialidad', 'aniosExperiencia'
        ])
        && d.rol == 'entrenador'
        && d.nombre is string
        && d.nombre.size() >= 3
        && d.nombre.size() <= 100
        && d.correo is string
        && d.correo.size() <= 150
        && d.cedula is string
        && d.cedula.matches('^[0-9]{5,20}$')
        && d.especialidad is string
        && d.especialidad.size() >= 2
        && d.especialidad.size() <= 100
        && d.aniosExperiencia is int
        && d.aniosExperiencia >= 0
        && d.aniosExperiencia <= 60
        && getAfter(
          /databases/$(database)/documents/cedulas/$(d.cedula)
        ).data.uid == uid;
    }

    function edicionPropiaValida() {
      let cambiados =
        request.resource.data.diff(resource.data).affectedKeys();

      return resource.data.rol in [
          'estudiante', 'entrenador', 'administrador'
        ]
        && cambiados.hasOnly(
          resource.data.rol == 'estudiante'
            ? ['nombre', 'carnet']
            : ['nombre']
        )
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 100
        && (
          resource.data.rol != 'estudiante'
          || (
            request.resource.data.carnet is string
            && request.resource.data.carnet.matches(
              '^[a-zA-Z0-9-]{4,24}$'
            )
            && (
              request.resource.data.carnet == resource.data.carnet
              || cambioCarnetValido()
            )
          )
        );
    }

    // El cambio de carnet exige crear el nuevo indice
    // y eliminar el antiguo en la misma operacion.
    function cambioCarnetValido() {
      let uid = request.auth.uid;
      let anterior = resource.data.carnet;
      let nuevo = request.resource.data.carnet;

      return anterior is string
        && anterior != nuevo
        && exists(
          /databases/$(database)/documents/carnets/$(anterior)
        )
        && get(
          /databases/$(database)/documents/carnets/$(anterior)
        ).data.uid == uid
        && !exists(
          /databases/$(database)/documents/carnets/$(nuevo)
        )
        && !existsAfter(
          /databases/$(database)/documents/carnets/$(anterior)
        )
        && getAfter(
          /databases/$(database)/documents/carnets/$(nuevo)
        ).data.uid == uid;
    }

    // Indice compartido por estudiantes y entrenadores.
    match /cedulas/{cedula} {
      allow get: if esAdministrador();
      allow list: if false;

      allow create: if request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.keys().hasAll(['uid'])
        && request.resource.data.uid is string
        && (
          // Alta de entrenador gestionada por administrador.
          (
            esAdministrador()
            && getAfter(
              /databases/$(database)/documents/usuarios/$(request.resource.data.uid)
            ).data.cedula == cedula
            && getAfter(
              /databases/$(database)/documents/usuarios/$(request.resource.data.uid)
            ).data.rol == 'entrenador'
          )
          ||
          // Alta de estudiante propietario.
          (
            esPropietario(request.resource.data.uid)
            && !exists(
              /databases/$(database)/documents/usuarios/$(request.auth.uid)
            )
            && getAfter(
              /databases/$(database)/documents/usuarios/$(request.auth.uid)
            ).data.cedula == cedula
            && getAfter(
              /databases/$(database)/documents/usuarios/$(request.auth.uid)
            ).data.rol == 'estudiante'
          )
        );

      allow update, delete: if false;
    }

    // Indice unico de carnets de estudiantes.
    match /carnets/{carnet} {
      allow get: if esAdministrador();
      allow list: if false;

      allow create: if autenticado()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.keys().hasAll(['uid'])
        && request.resource.data.uid == request.auth.uid
        && carnet.matches('^[a-zA-Z0-9-]{4,24}$')
        && getAfter(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.rol == 'estudiante'
        && getAfter(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.carnet == carnet
        && (
          // Registro inicial.
          !exists(
            /databases/$(database)/documents/usuarios/$(request.auth.uid)
          )
          ||
          // Cambio de carnet: el antiguo desaparece.
          (
            get(
              /databases/$(database)/documents/usuarios/$(request.auth.uid)
            ).data.carnet != carnet
            && !existsAfter(
              /databases/$(database)/documents/carnets/$(get(
                /databases/$(database)/documents/usuarios/$(request.auth.uid)
              ).data.carnet)
            )
          )
        );

      // No se permite modificar el propietario de un carnet.
      allow update: if false;

      // Eliminar el indice solo al cambiar el carnet del perfil.
      allow delete: if autenticado()
        && resource.data.uid == request.auth.uid
        && exists(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.carnet == carnet
        && getAfter(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.carnet != carnet
        && getAfter(
          /databases/$(database)/documents/carnets/$(getAfter(
            /databases/$(database)/documents/usuarios/$(request.auth.uid)
          ).data.carnet)
        ).data.uid == request.auth.uid;
    }

    match /usuarios/{uid} {
      allow get: if esPropietario(uid) || esAdministrador();
      allow list: if esAdministrador();
      // Solo estudiantes pueden auto-registrarse. El administrador y el
      // entrenador se aprovisionan de manera privilegiada (Firebase Console).
      allow create: if nuevoEstudianteValido(uid) || nuevoEntrenadorAdminValido(uid);
      // Ni siquiera el admin puede promover roles desde el cliente.
      allow update: if (esPropietario(uid) && edicionPropiaValida())
        || (esAdministrador()
          && resource.data.rol == 'estudiante'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
          && request.resource.data.estado in ['activo', 'inactivo']);
      allow delete: if false;
    }

    // Hito 2: cerrado intencionalmente hasta integrar la lógica Hito 3.
    // Agregar reglas por entidad de modo revisado, nunca allow write: if true.
    // A1 HITO 3: Administracion de deportes (PR de Alexander)
    // Solo datos publicos de catalogo. El resto de colecciones sigue cerrado.
    function datosDeporteValidos(codigo) {
      let d = request.resource.data;
      return d.keys().hasAll([
          'codigo', 'nombre', 'descripcion', 'disciplina', 'costo',
          'imagenUrl', 'cupoMaximo', 'cuposOcupados', 'cuposConfirmados',
          'entrenadorUid', 'entrenadorNombre', 'entrenadorEspecialidad',
          'horarios', 'dias', 'activo', 'promedioCalificacion',
          'totalResenas', 'creadoEn', 'actualizadoEn'
        ])
        && d.keys().hasOnly([
          'codigo', 'nombre', 'descripcion', 'disciplina', 'costo',
          'imagenUrl', 'cupoMaximo', 'cuposOcupados', 'cuposConfirmados',
          'entrenadorUid', 'entrenadorNombre', 'entrenadorEspecialidad',
          'horarios', 'dias', 'activo', 'promedioCalificacion',
          'totalResenas', 'creadoEn', 'actualizadoEn'
        ])
        && d.codigo == codigo
        && d.codigo is string
        && d.codigo.matches('^[A-Z]{3}-[0-9]{2}$')
        && d.nombre is string && d.nombre.size() >= 3 && d.nombre.size() <= 100
        && d.descripcion is string && d.descripcion.size() <= 500
        && d.disciplina in ['colectivo', 'individual', 'raqueta', 'combate', 'acuatico']
        && d.costo is number && d.costo >= 0
        && (d.imagenUrl == null || d.imagenUrl is string)
        && d.cupoMaximo is int && d.cupoMaximo > 0
        && d.cuposOcupados is int && d.cuposOcupados >= 0
        && d.cuposConfirmados is int && d.cuposConfirmados >= 0
        && d.cuposConfirmados <= d.cuposOcupados
        && d.cuposOcupados <= d.cupoMaximo
        && (d.entrenadorUid == null || d.entrenadorUid is string)
        && (d.entrenadorNombre == null || d.entrenadorNombre is string)
        && (d.entrenadorEspecialidad == null || d.entrenadorEspecialidad is string)
        && d.horarios is list && d.dias is list
        && d.activo is bool
        && d.promedioCalificacion is number
        && d.promedioCalificacion >= 0 && d.promedioCalificacion <= 5
        && d.totalResenas is int && d.totalResenas >= 0
        && d.creadoEn is timestamp;
    }

    // A3.6 — Seguridad para RF-17/RF-06. No abre contadores de deportes.
    function puedeResenar(uid, codigo) {
      let inscripcionId = uid + '_' + codigo;
      return autenticado()
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/usuarios/$(uid))
        && get(/databases/$(database)/documents/usuarios/$(uid)).data.rol == 'estudiante'
        && exists(/databases/$(database)/documents/inscripciones/$(inscripcionId))
        && get(/databases/$(database)/documents/inscripciones/$(inscripcionId)).data.estado == 'confirmada'
        && get(/databases/$(database)/documents/inscripciones/$(inscripcionId)).data.estudianteUid == uid
        && get(/databases/$(database)/documents/inscripciones/$(inscripcionId)).data.deporteId == codigo;
    }

    function resenaValida(d) {
      return d.keys().hasAll([
          'estudianteNombre', 'puntuacion', 'comentario', 'oculta', 'fecha'
        ])
        && d.keys().hasOnly([
          'estudianteNombre', 'puntuacion', 'comentario', 'oculta', 'fecha'
        ])
        && d.estudianteNombre is string
        && d.estudianteNombre.size() <= 100
        && d.puntuacion is int
        && d.puntuacion >= 1 && d.puntuacion <= 5
        && d.comentario is string && d.comentario.size() <= 300
        && d.oculta is bool
        && d.fecha is timestamp;
    }

    function busquedaValida() {
      let d = request.resource.data;
      return d.keys().hasAll([
          'termino', 'filtros', 'deporteIds', 'usuarioUid', 'fecha'
        ])
        && d.keys().hasOnly([
          'termino', 'filtros', 'deporteIds', 'usuarioUid', 'fecha'
        ])
        && d.termino is string && d.termino.size() <= 120
        && d.filtros is map
        && d.filtros.keys().hasOnly([
          'disciplina', 'dia', 'turno', 'especialidad', 'soloConCupo'
        ])
        && (!('disciplina' in d.filtros) || d.filtros.disciplina is string)
        && (!('dia' in d.filtros) || d.filtros.dia is string)
        && (!('turno' in d.filtros) || d.filtros.turno is string)
        && (!('especialidad' in d.filtros) || d.filtros.especialidad is string)
        && (!('soloConCupo' in d.filtros) || d.filtros.soloConCupo is bool)
        && d.deporteIds is list && d.deporteIds.size() <= 50
        && (d.usuarioUid == null
          || (autenticado() && d.usuarioUid == request.auth.uid))
        && d.fecha is timestamp
        && d.fecha >= request.time - duration.value(10, 'm')
        && d.fecha <= request.time + duration.value(10, 'm');
    }

    // A2 Spark — Agenda respaldada por transacciones de cliente y control/agenda

    // SPARK_PASO2_AGENDA_RESENAS_V1. Las escrituras relacionadas se validan
    // atomicamente mediante getAfter() y cambios restringidos por campo.
    function rutaDeporte(codigo) {
      return /databases/$(database)/documents/deportes/$(codigo);
    }

    function rutaResena(codigo, uid) {
      return /databases/$(database)/documents/deportes/$(codigo)/resenas/$(uid);
    }

    function rutaControlAgenda() {
      return /databases/$(database)/documents/control/agenda;
    }

    function promedioCercano(valor, esperado) {
      return valor is number
        && valor >= esperado - 0.000001
        && valor <= esperado + 0.000001;
    }

    // En la misma transaccion, crear una resena visible incrementa el total.
    function agregadoNuevaResena(codigo, puntos) {
      let antes = get(rutaDeporte(codigo)).data;
      let despues = getAfter(rutaDeporte(codigo)).data;
      return despues.totalResenas == antes.totalResenas + 1
        && promedioCercano(
          despues.promedioCalificacion,
          (antes.promedioCalificacion * antes.totalResenas + puntos)
            / (antes.totalResenas + 1)
        );
    }

    // Editar la puntuacion de una resena visible conserva el total.
    function agregadoEditarResena(codigo, anterior, nuevo) {
      let antes = get(rutaDeporte(codigo)).data;
      let despues = getAfter(rutaDeporte(codigo)).data;
      return antes.totalResenas > 0
        && despues.totalResenas == antes.totalResenas
        && promedioCercano(
          despues.promedioCalificacion,
          (antes.promedioCalificacion * antes.totalResenas - anterior + nuevo)
            / antes.totalResenas
        );
    }

    // Ocultar o mostrar requiere que el administrador ajuste el agregado.
    function agregadoVisibilidadResena(codigo, puntos, ocultar) {
      let antes = get(rutaDeporte(codigo)).data;
      let despues = getAfter(rutaDeporte(codigo)).data;
      return ocultar
        ? (antes.totalResenas > 0
          && despues.totalResenas == antes.totalResenas - 1
          && promedioCercano(
            despues.promedioCalificacion,
            antes.totalResenas == 1 ? 0 :
              (antes.promedioCalificacion * antes.totalResenas - puntos)
                / (antes.totalResenas - 1)
          ))
        : (despues.totalResenas == antes.totalResenas + 1
          && promedioCercano(
            despues.promedioCalificacion,
            (antes.promedioCalificacion * antes.totalResenas + puntos)
              / (antes.totalResenas + 1)
          ));
    }

    // En el update de deportes, un estudiante solo puede ajustar el agregado
    // si SU resena cambia en este mismo commit y la cuenta es consistente.
    function agregadoEstudianteAutorizado(codigo) {
      let ruta = rutaResena(codigo, request.auth.uid);
      let antes = resource.data;
      let despues = request.resource.data;
      return autenticado()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['promedioCalificacion', 'totalResenas'])
        && existsAfter(ruta)
        && (
          (!exists(ruta)
            && getAfter(ruta).data.oculta == false
            && despues.totalResenas == antes.totalResenas + 1
            && promedioCercano(
              despues.promedioCalificacion,
              (antes.promedioCalificacion * antes.totalResenas
                + getAfter(ruta).data.puntuacion)
                  / (antes.totalResenas + 1)
            ))
          || (exists(ruta)
            && get(ruta).data.oculta == false
            && getAfter(ruta).data.oculta == false
            && getAfter(ruta).data.puntuacion != get(ruta).data.puntuacion
            && antes.totalResenas > 0
            && despues.totalResenas == antes.totalResenas
            && promedioCercano(
              despues.promedioCalificacion,
              (antes.promedioCalificacion * antes.totalResenas
                - get(ruta).data.puntuacion
                + getAfter(ruta).data.puntuacion) / antes.totalResenas
            ))
        );
    }

    // Spark A3: una marca atomica permite identificar la reseña que un
    // administrador modera. Sin esta marca, no se autoriza editar el agregado.
    // Es un unico documento global: adecuado para escala academica reducida.
    function rutaControlResenas() {
      return /databases/$(database)/documents/control/resenas;
    }

    function moderacionConControl(codigo) {
      let marca = rutaControlResenas();
      let uid = getAfter(marca).data.estudianteUid;
      let resena = rutaResena(codigo, uid);
      return existsAfter(marca)
        && getAfter(marca).data.codigoDeporte == codigo
        && getAfter(marca).data.adminUid == request.auth.uid
        && getAfter(marca).data.actualizadoEn == request.time
        && getAfter(marca).data.version ==
          (exists(marca) ? get(marca).data.version : 0) + 1
        && exists(resena) && existsAfter(resena)
        && get(resena).data.oculta != getAfter(resena).data.oculta
        && get(resena).data.puntuacion == getAfter(resena).data.puntuacion
        && agregadoVisibilidadResena(
          codigo,
          get(resena).data.puntuacion,
          getAfter(resena).data.oculta
        );
    }

    function controlResenasValido() {
      let d = request.resource.data;
      let resena = rutaResena(d.codigoDeporte, d.estudianteUid);
      return d.keys().hasAll([
          'version', 'codigoDeporte', 'estudianteUid',
          'adminUid', 'actualizadoEn'
        ])
        && d.keys().hasOnly([
          'version', 'codigoDeporte', 'estudianteUid',
          'adminUid', 'actualizadoEn'
        ])
        && d.version is int && d.version >= 1
        && d.codigoDeporte is string
        && d.codigoDeporte.matches('^[A-Z]{3}-[0-9]{2}$')
        && d.estudianteUid is string
        && d.estudianteUid.size() > 0 && d.estudianteUid.size() <= 128
        && d.adminUid == request.auth.uid
        && d.actualizadoEn == request.time
        && exists(resena) && existsAfter(resena)
        && get(resena).data.oculta != getAfter(resena).data.oculta
        && get(resena).data.puntuacion == getAfter(resena).data.puntuacion
        && agregadoVisibilidadResena(
          d.codigoDeporte,
          get(resena).data.puntuacion,
          getAfter(resena).data.oculta
        );
    }

    // Version global de agenda; impide confirmar dos asignaciones basadas
    // en el mismo estado cuando trabajan administradores simultaneamente.
    function agendaConControl(codigo) {
      let ruta = rutaControlAgenda();
      return existsAfter(ruta)
        && getAfter(ruta).data.codigoDeporte == codigo
        && getAfter(ruta).data.adminUid == request.auth.uid
        && getAfter(ruta).data.actualizadoEn == request.time
        && getAfter(ruta).data.version ==
          (exists(ruta) ? get(ruta).data.version : 0) + 1;
    }

    function controlAgendaValido() {
      let d = request.resource.data;
      return d.keys().hasAll([
          'version', 'codigoDeporte', 'adminUid', 'actualizadoEn'
        ])
        && d.keys().hasOnly([
          'version', 'codigoDeporte', 'adminUid', 'actualizadoEn'
        ])
        && d.version is int && d.version >= 1
        && d.codigoDeporte is string
        && d.codigoDeporte.matches('^[A-Z]{3}-[0-9]{2}$')
        && d.adminUid == request.auth.uid
        && d.actualizadoEn == request.time
        && exists(rutaDeporte(d.codigoDeporte))
        && getAfter(rutaDeporte(d.codigoDeporte)).data.actualizadoEn == request.time;
    }

    // INS Spark: solo reservas y cancelaciones vinculadas en la misma operacion.
    // Mantener separadas las condiciones comerciales, de agenda y de resenas.
    function actualizacionCuposInscripcion(codigo) {
      let cambios = request.resource.data.diff(resource.data).affectedKeys();
      return (
          autenticado()
          && cambios.hasOnly([
              'cuposOcupados', 'cuposConfirmados'
            ])

          && (

            // INS-01: reservar un cupo.
            (
              cambios.hasOnly(['cuposOcupados'])
              && resource.data.activo == true
              && request.resource.data.cuposOcupados is int
              && request.resource.data.cuposOcupados ==
                resource.data.cuposOcupados + 1
              && request.resource.data.cuposOcupados <=
                resource.data.cupoMaximo
              && request.resource.data.cuposConfirmados ==
                resource.data.cuposConfirmados
              && (
                inscripcionNuevaVinculada(codigo)
                || reinscripcionVinculada(codigo)
              )
            )

            ||

            // INS-13: cancelar pendiente.
            (
              cambios.hasOnly(['cuposOcupados'])
              && resource.data.cuposOcupados > 0
              && request.resource.data.cuposOcupados is int
              && request.resource.data.cuposOcupados ==
                resource.data.cuposOcupados - 1
              && request.resource.data.cuposConfirmados ==
                resource.data.cuposConfirmados
              && (cancelacionVinculada(codigo)
                || expiracionVinculada(codigo)
                || rechazoVinculado(codigo))
            )

            ||

            // INS-18: cancelar confirmada.
            (
              resource.data.cuposOcupados > 0
              && resource.data.cuposConfirmados > 0
              && request.resource.data.cuposOcupados ==
                resource.data.cuposOcupados - 1
              && request.resource.data.cuposConfirmados ==
                resource.data.cuposConfirmados - 1
              && get(rutaInscripcionPropia(codigo)).data.estado ==
                'confirmada'
              && cancelacionVinculada(codigo)
            )
          )
        );
    }

    // INS-01: reserva atomica de un cupo

    function rutaInscripcionPropia(codigo) {
      return /databases/$(database)/documents/inscripciones/$(request.auth.uid + '_' + codigo);
    }

    function rutaDeporteInscripcion(codigo) {
      return /databases/$(database)/documents/deportes/$(codigo);
    }

    function estudianteActivoInscripcion() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && usuarioActual().rol == 'estudiante'
        && usuarioActual().estado == 'activo';
    }

    function contadorReservaValido(codigo) {
      let anterior = get(rutaDeporteInscripcion(codigo)).data;
      let posterior = getAfter(rutaDeporteInscripcion(codigo)).data;

      return anterior.activo == true
        && anterior.cupoMaximo is int
        && anterior.cuposOcupados is int
        && anterior.cuposOcupados < anterior.cupoMaximo
        && posterior.cuposOcupados == anterior.cuposOcupados + 1
        && posterior.cuposConfirmados == anterior.cuposConfirmados
        && posterior.diff(anterior).affectedKeys()
          .hasOnly(['cuposOcupados']);
    }

    function inscripcionNuevaVinculada(codigo) {
      let ruta = rutaInscripcionPropia(codigo);

      return autenticado()
        && !exists(ruta)
        && existsAfter(ruta)
        && estudianteActivoInscripcion()
        && getAfter(ruta).data.estudianteUid == request.auth.uid
        && getAfter(ruta).data.deporteId == codigo
        && getAfter(ruta).data.estado == 'pendiente';
    }
    // Reinscripcion: el documento ya existe y debe cambiar de un estado
    // terminal a pendiente en la MISMA transaccion que incrementa el cupo.
    function reinscripcionVinculada(codigo) {
      let ruta = rutaInscripcionPropia(codigo);
      return autenticado()
        && exists(ruta)
        && estudianteActivoInscripcion()
        && reinscripcionVinculadaExistente(ruta, codigo);
    }

    function reinscripcionVinculadaExistente(ruta, codigo) {
      let anterior = get(ruta).data;
      let posterior = getAfter(ruta).data;
      return anterior.estudianteUid == request.auth.uid
        && anterior.deporteId == codigo
        && anterior.estado in ['cancelada', 'expirada', 'rechazada']
        && posterior.estado == 'pendiente'
        && transicionReinscripcionValida(anterior, posterior);
    }

    function nuevaInscripcionValida(inscripcionId) {
      let d = request.resource.data;
      let u = usuarioActual();
      let deporte = get(rutaDeporteInscripcion(d.deporteId)).data;

      return estudianteActivoInscripcion()
        && d.keys().hasAll([
          'estudianteUid', 'estudianteCedula',
          'estudianteNombre', 'estudianteCarnet',
          'estudianteCorreo', 'deporteId',
          'deporteNombre', 'entrenadorUid',
          'estado', 'motivo', 'fechaInscripcion',
          'fechaLimitePago', 'pagoId', 'historial'
        ])
        && d.keys().hasOnly([
          'estudianteUid', 'estudianteCedula',
          'estudianteNombre', 'estudianteCarnet',
          'estudianteCorreo', 'deporteId',
          'deporteNombre', 'entrenadorUid',
          'estado', 'motivo', 'fechaInscripcion',
          'fechaLimitePago', 'pagoId', 'historial'
        ])
        && d.estudianteUid == request.auth.uid
        && d.deporteId is string
        && d.deporteId.matches('^[A-Z]{3}-[0-9]{2}$')
        && inscripcionId == request.auth.uid + '_' + d.deporteId
        && d.estudianteCedula == u.cedula
        && d.estudianteNombre == u.nombre
        && d.estudianteCarnet == u.carnet
        && d.estudianteCorreo == u.correo
        && d.deporteNombre == deporte.nombre
        && d.entrenadorUid == deporte.entrenadorUid
        && d.estado == 'pendiente'
        && d.motivo == null
        && d.pagoId == null
        && d.fechaInscripcion is timestamp
        && d.fechaLimitePago is timestamp
        && d.fechaInscripcion >= request.time - duration.value(5, 'm')
        && d.fechaInscripcion <= request.time + duration.value(5, 'm')
        && d.fechaLimitePago > d.fechaInscripcion
        && d.fechaLimitePago <=
          d.fechaInscripcion + duration.value(25, 'h')
        && d.historial is list
        && d.historial.size() == 1
        && d.historial[0] is map
        && d.historial[0].keys().hasAll([
          'estado', 'fecha', 'responsableUid'
        ])
        && d.historial[0].keys().hasOnly([
          'estado', 'fecha', 'responsableUid'
        ])
        && d.historial[0].estado == 'pendiente'
        && d.historial[0].responsableUid == request.auth.uid
        && d.historial[0].fecha is timestamp
        && contadorReservaValido(d.deporteId);
    }

    // INS-13: transicion segura de pendiente a cancelada.
    function transicionCancelacionValida(antes, despues) {
      let entrada = despues.historial[antes.historial.size()];

      return antes.estado in ['pendiente', 'confirmada']
        && despues.estado == 'cancelada'
        && antes.estudianteUid == request.auth.uid
        && antes.historial is list
        && despues.historial is list
        && despues.historial.size() == antes.historial.size() + 1
        && despues.historial == antes.historial.concat([entrada])
        && entrada is map
        && entrada.keys().hasOnly([
          'estado', 'fecha', 'responsableUid'
        ])
        && entrada.keys().hasAll([
          'estado', 'fecha', 'responsableUid'
        ])
        && entrada.estado == 'cancelada'
        && entrada.responsableUid == request.auth.uid
        && entrada.fecha is timestamp
        && entrada.fecha >= request.time - duration.value(5, 'm')
        && entrada.fecha <= request.time + duration.value(5, 'm')
        && despues.motivo == null
        && despues.diff(antes).affectedKeys().hasOnly([
          'estado', 'motivo', 'historial'
        ]);
    }

    // La inscripcion solo se cancela si se libera un cupo.
    function contadorCancelacionValido(codigo, estadoAnterior) {
      let anterior = get(rutaDeporteInscripcion(codigo)).data;
      let posterior = getAfter(rutaDeporteInscripcion(codigo)).data;

      return anterior.cuposOcupados is int
        && anterior.cuposOcupados > 0
        && posterior.cuposOcupados == anterior.cuposOcupados - 1
        && posterior.cuposConfirmados ==
          (estadoAnterior == 'confirmada'
            ? anterior.cuposConfirmados - 1
            : anterior.cuposConfirmados)
        && posterior.diff(anterior).affectedKeys().hasOnly(
          estadoAnterior == 'confirmada'
            ? ['cuposOcupados', 'cuposConfirmados']
            : ['cuposOcupados']
        );
    }

    // Comprueba la identidad y el cambio del contador.
    function cancelacionPropiaValida(inscripcionId) {
      return autenticado()
        && resource.data.estudianteUid == request.auth.uid
        && resource.data.deporteId is string
        && inscripcionId ==
          request.auth.uid + '_' + resource.data.deporteId
        && transicionCancelacionValida(
          resource.data, request.resource.data
        )
        && contadorCancelacionValido(
          resource.data.deporteId,
          resource.data.estado
        );
    }

    // Reinscripcion: conservar la identidad y el historial; solicitar
    // una nueva reserva sin arrastrar un pago de la solicitud anterior.
    function transicionReinscripcionValida(antes, despues) {
      let historialPrevio = antes.historial;
      let entrada = despues.historial[historialPrevio.size()];
      return autenticado()
        && antes.estado in ['cancelada', 'expirada', 'rechazada']
        && antes.estudianteUid == request.auth.uid
        && antes.deporteId is string
        && despues.estado == 'pendiente'
        && despues.diff(antes).affectedKeys().hasOnly([
          'estado', 'motivo', 'fechaInscripcion',
          'fechaLimitePago', 'pagoId', 'historial'
        ])
        && despues.motivo == null
        && despues.pagoId == null
        && despues.fechaInscripcion is timestamp
        && despues.fechaLimitePago is timestamp
        && despues.fechaInscripcion >= request.time - duration.value(5, 'm')
        && despues.fechaInscripcion <= request.time + duration.value(5, 'm')
        && despues.fechaLimitePago > despues.fechaInscripcion
        && despues.fechaLimitePago <=
          despues.fechaInscripcion + duration.value(25, 'h')
        && historialPrevio is list
        && despues.historial is list
        && despues.historial.size() == historialPrevio.size() + 1
        && despues.historial == historialPrevio.concat([entrada])
        && entrada is map
        && entrada.keys().hasOnly([
          'estado', 'fecha', 'responsableUid'
        ])
        && entrada.keys().hasAll([
          'estado', 'fecha', 'responsableUid'
        ])
        && entrada.estado == 'pendiente'
        && entrada.responsableUid == request.auth.uid
        && entrada.fecha is timestamp
        && entrada.fecha >= request.time - duration.value(5, 'm')
        && entrada.fecha <= request.time + duration.value(5, 'm');
    }

    function reinscripcionPropiaValida(inscripcionId) {
      return estudianteActivoInscripcion()
        && resource.data.estudianteUid == request.auth.uid
        && resource.data.deporteId is string
        && inscripcionId ==
          request.auth.uid + '_' + resource.data.deporteId
        && transicionReinscripcionValida(
          resource.data, request.resource.data
        )
        && contadorReservaValido(resource.data.deporteId);
    }

    // INS: expirar una solicitud pendiente vencida.
    // El estudiante propietario ejecuta una transaccion que tambien
    // resta exactamente un cupo ocupado del deporte.
    function transicionExpiracionValida(antes, despues) {
      let entrada = despues.historial[antes.historial.size()];
      return autenticado()
        && antes.estudianteUid == request.auth.uid
        && antes.estado == 'pendiente'
        && antes.fechaLimitePago is timestamp
        && request.time >= antes.fechaLimitePago
        && despues.estado == 'expirada'
        && despues.motivo == 'plazo_vencido'
        && despues.diff(antes).affectedKeys().hasOnly([
          'estado', 'motivo', 'historial'
        ])
        && antes.historial is list
        && despues.historial is list
        && despues.historial.size() == antes.historial.size() + 1
        && despues.historial == antes.historial.concat([entrada])
        && entrada is map
        && entrada.keys().hasAll(['estado', 'fecha', 'responsableUid'])
        && entrada.keys().hasOnly(['estado', 'fecha', 'responsableUid'])
        && entrada.estado == 'expirada'
        && entrada.responsableUid == request.auth.uid
        && entrada.fecha is timestamp
        && entrada.fecha >= request.time - duration.value(5, 'm')
        && entrada.fecha <= request.time + duration.value(5, 'm');
    }

    function expiracionPropiaValida(inscripcionId) {
      return autenticado()
        && resource.data.estudianteUid == request.auth.uid
        && resource.data.deporteId is string
        && inscripcionId == request.auth.uid + '_' + resource.data.deporteId
        && transicionExpiracionValida(resource.data, request.resource.data)
        && contadorCancelacionValido(resource.data.deporteId, 'pendiente');
    }

    // Solo permite restar el cupo si la inscripcion propia pasa
    // realmente a expirada en este mismo lote o transaccion.
    function expiracionVinculada(codigo) {
      let ruta = rutaInscripcionPropia(codigo);
      return autenticado()
        && exists(ruta)
        && expiracionVinculadaExistente(ruta, codigo);
    }

    function expiracionVinculadaExistente(ruta, codigo) {
      let anterior = get(ruta).data;
      let posterior = getAfter(ruta).data;
      return anterior.estudianteUid == request.auth.uid
        && anterior.deporteId == codigo
        && transicionExpiracionValida(anterior, posterior);
    }

    // RECH-01: rechazar una reserva pendiente de estudiante inactivo.
    function transicionRechazoValida(antes, despues) {
      let entrada = despues.historial[antes.historial.size()];

      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && usuarioActual().rol == 'estudiante'
        && usuarioActual().estado == 'inactivo'
        && antes.estudianteUid == request.auth.uid
        && antes.estado == 'pendiente'
        && despues.estado == 'rechazada'
        && despues.motivo == 'estudiante_inactivo'
        && despues.diff(antes).affectedKeys().hasOnly([
          'estado', 'motivo', 'historial'
        ])
        && antes.historial is list
        && despues.historial is list
        && despues.historial.size() == antes.historial.size() + 1
        && despues.historial == antes.historial.concat([entrada])
        && entrada is map
        && entrada.keys().hasAll([
          'estado', 'fecha', 'responsableUid'
        ])
        && entrada.keys().hasOnly([
          'estado', 'fecha', 'responsableUid'
        ])
        && entrada.estado == 'rechazada'
        && entrada.responsableUid == request.auth.uid
        && entrada.fecha is timestamp
        && entrada.fecha >= request.time - duration.value(5, 'm')
        && entrada.fecha <= request.time + duration.value(5, 'm');
    }

    // Solo el propietario inactivo puede rechazar su reserva.
    // La liberacion del cupo debe ocurrir en la misma transaccion.
    function rechazoPropioValido(inscripcionId) {
      return autenticado()
        && resource.data.estudianteUid == request.auth.uid
        && resource.data.deporteId is string
        && inscripcionId ==
          request.auth.uid + '_' + resource.data.deporteId
        && transicionRechazoValida(
          resource.data, request.resource.data
        )
        && contadorCancelacionValido(
          resource.data.deporteId, 'pendiente'
        );
    }

    // Impide disminuir cupos sin una transicion real a rechazada.
    function rechazoVinculado(codigo) {
      let ruta = rutaInscripcionPropia(codigo);

      return autenticado()
        && exists(ruta)
        && rechazoVinculadoExistente(ruta, codigo);
    }

    function rechazoVinculadoExistente(ruta, codigo) {
      let anterior = get(ruta).data;
      let posterior = getAfter(ruta).data;

      return anterior.estudianteUid == request.auth.uid
        && anterior.deporteId == codigo
        && transicionRechazoValida(anterior, posterior);
    }

    // Comprueba que la reduccion de cupos corresponde
    // a una cancelacion real en la misma transaccion.
    // Verificar primero que exista la inscripcion vinculada.
    function cancelacionVinculada(codigo) {
      let ruta = rutaInscripcionPropia(codigo);

      return autenticado()
        && exists(ruta)
        && cancelacionVinculadaExistente(ruta, codigo);
    }

    function cancelacionVinculadaExistente(ruta, codigo) {
      let anterior = get(ruta).data;
      let posterior = getAfter(ruta).data;

      return anterior.estudianteUid == request.auth.uid
        && anterior.deporteId == codigo
        && anterior.estado in ['pendiente', 'confirmada']
        && posterior.estado == 'cancelada'
        && transicionCancelacionValida(anterior, posterior);
    }
    // HITO 3 - Inscripciones deportivas
    // Primera etapa: lectura de inscripciones propias.

    function idInscripcionPropia(inscripcionId) {
      return autenticado()
        && inscripcionId.matches(
          '^' + request.auth.uid + '_[A-Z]{3}-[0-9]{2}$'
        );
    }


    match /deportes/{codigo} {
      // La lectura del catalogo es publica (RF-05). No incluir datos privados.
      allow get, list: if true;

      // Para crear un deporte los contadores e indicadores empiezan en cero.
      allow create: if esAdministrador()
        && datosDeporteValidos(codigo)
        && request.resource.data.cuposOcupados == 0
        && request.resource.data.cuposConfirmados == 0
        && request.resource.data.promedioCalificacion == 0
        && request.resource.data.totalResenas == 0
        && request.resource.data.actualizadoEn == null
        // A2 Spark: la asignacion inicial pasa por la transaccion de agenda.
        && request.resource.data.entrenadorUid == null
        && request.resource.data.entrenadorNombre == null
        && request.resource.data.entrenadorEspecialidad == null
        && request.resource.data.horarios.size() == 0
        && request.resource.data.dias.size() == 0;

      // Edicion comercial normal, agenda serializada o agregado de resenas.
      // Ningun estudiante puede alterar cupos ni los atributos comerciales.
      allow update: if (
        // El filtro por campos evita evaluar controles no relacionados.
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['cuposOcupados', 'cuposConfirmados'])
          && actualizacionCuposInscripcion(codigo)
        )
        || (
          esAdministrador()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nombre', 'descripcion', 'disciplina', 'costo', 'imagenUrl',
            'cupoMaximo', 'activo', 'actualizadoEn'
          ])
          && request.resource.data.actualizadoEn is timestamp
        )
        || (
          esAdministrador()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'entrenadorUid', 'entrenadorNombre', 'entrenadorEspecialidad',
            'horarios', 'dias', 'actualizadoEn'
          ])
          && request.resource.data.actualizadoEn == request.time
          && agendaConControl(codigo)
        )
        || (
          esAdministrador()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'promedioCalificacion', 'totalResenas'
          ])
          && moderacionConControl(codigo)
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'promedioCalificacion', 'totalResenas'
          ])
          && agregadoEstudianteAutorizado(codigo)
        )
      ) && datosDeporteValidos(codigo);

      allow delete: if false;

      // A3.6: el propietario puede leer su documento (incluso si no existe
      // o está oculto); el público solo ve reseñas visibles y el admin todas.
      // Las consultas de colección siguen exigiendo el filtro de visibilidad.
      match /resenas/{estudianteUid} {
        allow get: if esAdministrador()
          || (autenticado() && request.auth.uid == estudianteUid)
          || (resource != null && resource.data.oculta == false);
        allow list: if esAdministrador()
          || resource.data.oculta == false;

        // ID de documento = UID del autor. Una resena nueva se guarda con
        // incremento del promedio en la MISMA operacion atomica.
        allow create: if puedeResenar(estudianteUid, codigo)
          && resenaValida(request.resource.data)
          && request.resource.data.oculta == false
          && agregadoNuevaResena(codigo, request.resource.data.puntuacion);

        allow update: if (
            puedeResenar(estudianteUid, codigo)
            && resenaValida(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'estudianteNombre', 'puntuacion', 'comentario', 'fecha'
            ])
            && request.resource.data.oculta == resource.data.oculta
            // Si la nota cambia y la resena es visible, la media tambien.
            && (resource.data.oculta == true
              || request.resource.data.puntuacion == resource.data.puntuacion
              || agregadoEditarResena(
                codigo, resource.data.puntuacion, request.resource.data.puntuacion
              ))
          ) || (
            esAdministrador()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['oculta'])
            && request.resource.data.oculta is bool
            && request.resource.data.oculta != resource.data.oculta
            && agregadoVisibilidadResena(
              codigo, resource.data.puntuacion, request.resource.data.oculta
            )
          );
        allow delete: if false;
      }
    }

    // A3.5 — datos operativos: administrador lee todo; estudiante solo lo propio.
    // No habilitar escrituras de pagos desde Flutter. Inscripciones requieren
    // transacciones seguras de cupos acordadas con Mariana.
    // A3.10 — Lectura propia de inscripciones y pagos.
    // El frontend DEBE filtrar con where('estudianteUid', isEqualTo: uid).
    // Las escrituras de pagos siguen reservadas a las Cloud Functions (Admin SDK).
    match /inscripciones/{inscripcionId} {
      // Permitir lectura por el ID propio, incluso antes de crear el documento.
      allow get: if esAdministrador()
        || (autenticado()
            && (
              (idInscripcionPropia(inscripcionId) && resource == null)
              || (resource != null
                  && resource.data.estudianteUid == request.auth.uid)
            ));
      // Las consultas del estudiante deben filtrar por estudianteUid.
      allow list: if esAdministrador()
        || (autenticado() && resource.data.estudianteUid == request.auth.uid);
      // Crear y cancelar exige un cambio atomico coherente en los cupos.
      allow create: if nuevaInscripcionValida(inscripcionId);
      allow update: if cancelacionPropiaValida(inscripcionId)
        || reinscripcionPropiaValida(inscripcionId)
        || expiracionPropiaValida(inscripcionId)
        || rechazoPropioValido(inscripcionId);
      allow delete: if false;
    }

    match /pagos/{pagoId} {
      allow get, list: if esAdministrador()
        || (autenticado() && resource.data.estudianteUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // A2 Spark: un unico contador global para serializar agendas.
    match /control/{controlId} {
      allow get: if controlId in ['agenda', 'resenas'] && esAdministrador();
      allow list: if false;
      allow create: if (
          controlId == 'agenda'
          && esAdministrador()
          && controlAgendaValido()
          && request.resource.data.version == 1
        ) || (
          controlId == 'resenas'
          && esAdministrador()
          && controlResenasValido()
          && request.resource.data.version == 1
        );
      allow update: if (
          controlId == 'agenda'
          && esAdministrador()
          && controlAgendaValido()
          && request.resource.data.version == resource.data.version + 1
        ) || (
          controlId == 'resenas'
          && esAdministrador()
          && controlResenasValido()
          && request.resource.data.version == resource.data.version + 1
        );
      allow delete: if false;
    }

    match /busquedas/{busquedaId} {
      allow get, list: if esAdministrador();
      // RF-06: landing sin sesión y catálogo autenticado.
      // El cliente solo registra eventos; no puede leer/modificar registros.
      allow create: if busquedaValida();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
