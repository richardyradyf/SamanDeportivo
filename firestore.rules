rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function esPropietario(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    function usuarioActual() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function esAdministrador() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && usuarioActual().rol == 'administrador';
    }

    // NO usar esta condición como prueba de solvencia UNIMET.
    // El estado fue definido en el Hito 1, pero la validación institucional
    // se integrará en Hito 3 mediante lógica privilegiada del servidor.
    function nuevoEstudianteValido(uid) {
      return esPropietario(uid)
        && request.resource.data.keys().hasAll([
          'cedula', 'nombre', 'correo', 'rol', 'carnet', 'estado'
        ])
        && request.resource.data.keys().hasOnly([
          'cedula', 'nombre', 'correo', 'rol', 'carnet', 'estado'
        ])
        && request.resource.data.rol == 'estudiante'
        && request.resource.data.estado == 'activo'
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 100
        && request.resource.data.correo is string
        && request.resource.data.correo == request.auth.token.email
        && request.resource.data.cedula is string
        && request.resource.data.cedula.size() >= 5
        && request.resource.data.cedula.size() <= 20
        && request.resource.data.carnet is string
        && request.resource.data.carnet.matches('^[a-zA-Z0-9-]{4,24}$');
    }


    function edicionPropiaValida() {
      let cambiados = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.rol in ['estudiante', 'entrenador', 'administrador']
        && cambiados.hasOnly(resource.data.rol == 'estudiante'
          ? ['nombre', 'carnet'] : ['nombre'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 100
        && (resource.data.rol != 'estudiante'
          || (request.resource.data.carnet is string
            && request.resource.data.carnet.matches('^[a-zA-Z0-9-]{4,24}$')));
    }

    match /usuarios/{uid} {
      allow get: if esPropietario(uid) || esAdministrador();
      allow list: if esAdministrador();
      // Solo estudiantes pueden auto-registrarse. El administrador y el
      // entrenador se aprovisionan de manera privilegiada (Firebase Console).
      allow create: if nuevoEstudianteValido(uid);
      // Ni siquiera el admin puede promover roles desde el cliente.
      allow update: if esPropietario(uid) && edicionPropiaValida();
      allow delete: if false;
    }

    // Hito 2: cerrado intencionalmente hasta integrar la lógica Hito 3.
    // Agregar reglas por entidad de modo revisado, nunca allow write: if true.
    // A1 HITO 3: Administracion de deportes (PR de Alexander)
    // Solo datos publicos de catalogo. El resto de colecciones sigue cerrado.
    function datosDeporteValidos(codigo) {
      let d = request.resource.data;
      return d.keys().hasAll([
          'codigo', 'nombre', 'descripcion', 'disciplina', 'costo',
          'imagenUrl', 'cupoMaximo', 'cuposOcupados', 'cuposConfirmados',
          'entrenadorUid', 'entrenadorNombre', 'entrenadorEspecialidad',
          'horarios', 'dias', 'activo', 'promedioCalificacion',
          'totalResenas', 'creadoEn', 'actualizadoEn'
        ])
        && d.keys().hasOnly([
          'codigo', 'nombre', 'descripcion', 'disciplina', 'costo',
          'imagenUrl', 'cupoMaximo', 'cuposOcupados', 'cuposConfirmados',
          'entrenadorUid', 'entrenadorNombre', 'entrenadorEspecialidad',
          'horarios', 'dias', 'activo', 'promedioCalificacion',
          'totalResenas', 'creadoEn', 'actualizadoEn'
        ])
        && d.codigo == codigo
        && d.codigo is string
        && d.codigo.matches('^[A-Z]{3}-[0-9]{2}$')
        && d.nombre is string && d.nombre.size() >= 3 && d.nombre.size() <= 100
        && d.descripcion is string && d.descripcion.size() <= 500
        && d.disciplina in ['colectivo', 'individual', 'raqueta', 'combate', 'acuatico']
        && d.costo is number && d.costo >= 0
        && (d.imagenUrl == null || d.imagenUrl is string)
        && d.cupoMaximo is int && d.cupoMaximo > 0
        && d.cuposOcupados is int && d.cuposOcupados >= 0
        && d.cuposConfirmados is int && d.cuposConfirmados >= 0
        && d.cuposConfirmados <= d.cuposOcupados
        && d.cuposOcupados <= d.cupoMaximo
        && (d.entrenadorUid == null || d.entrenadorUid is string)
        && (d.entrenadorNombre == null || d.entrenadorNombre is string)
        && (d.entrenadorEspecialidad == null || d.entrenadorEspecialidad is string)
        && d.horarios is list && d.dias is list
        && d.activo is bool
        && d.promedioCalificacion is number
        && d.promedioCalificacion >= 0 && d.promedioCalificacion <= 5
        && d.totalResenas is int && d.totalResenas >= 0
        && d.creadoEn is timestamp;
    }

    // A2.3 — Agenda protegida por Cloud Functions
    match /deportes/{codigo} {
      // La lectura del catalogo es publica (RF-05). No incluir datos privados.
      allow get, list: if true;

      // Para crear un deporte los contadores e indicadores empiezan en cero.
      allow create: if esAdministrador()
        && datosDeporteValidos(codigo)
        && request.resource.data.cuposOcupados == 0
        && request.resource.data.cuposConfirmados == 0
        && request.resource.data.promedioCalificacion == 0
        && request.resource.data.totalResenas == 0
        && request.resource.data.actualizadoEn == null
        // A2.3: la asignación inicial también pasa por callable.
        && request.resource.data.entrenadorUid == null
        && request.resource.data.entrenadorNombre == null
        && request.resource.data.entrenadorEspecialidad == null
        && request.resource.data.horarios.size() == 0
        && request.resource.data.dias.size() == 0;

      // La administracion NO puede falsificar contadores/codigos/fechas.
      // Mariana definira por separado las transacciones protegidas para cupos.
      allow update: if esAdministrador()
        && datosDeporteValidos(codigo)
        && request.resource.data.actualizadoEn is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombre', 'descripcion', 'disciplina', 'costo', 'imagenUrl',
          'cupoMaximo', 'activo', 'actualizadoEn'
        ]);

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
